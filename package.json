{
  "name": "superops-docs-mcp",
  "version": "1.0.0",
  "description": "MCP server for SuperOps IT Documentation - search, read, and update docs via natural language",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "mcp-proxy --port 8082 -- node dist/index.js",
    "dev": "npx tsx src/index.ts",
    "dev:http": "mcp-proxy --port 8082 -- npx tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "tsx": "^4.0.0",
    "@types/node": "^20.0.0",
    "mcp-proxy": "^6.7.11"
  }
}
